  build-depends:
    base       >= 4.18 && < 5,
    bytestring >= 0.10 && < 0.13,
    memory     >= 0.18 && < 0.19,
    text       >= 1.2  && < 2.2,
    hs-libp2p,
    time       >= 1.9 && < 2,
    async      >= 2.2 && < 2.3,
    stm        >= 2.4 && < 2.6,
    containers >= 0.6 && < 0.8,
    crypton    >= 1.0.5 && < 1.1,
    crypton-asn1-encoding >= 0.9 && < 0.11,
    crypton-asn1-types >= 0.4 && < 0.5,
    crypton-x509 >= 1.8 && < 1.9,
    tls        >= 2.2 && < 2.3,
    time-hourglass >= 0.3 && < 0.4,
    ppad-base58 >= 0.2 && < 0.3,
    hspec      >= 2.11 && < 2.12,
    QuickCheck >= 2.14 && < 2.16
  build-tool-depends:
