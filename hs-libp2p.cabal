cabal-version:   3.12
name:            hs-libp2p
version:         0.1.0.0
synopsis:        Haskell implementation of the libp2p networking stack
description:
  A Haskell implementation of the libp2p modular peer-to-peer networking
  stack. Implements transport, security, multiplexing, and application
  protocols following the libp2p specification.
license:         MIT
license-file:    LICENSE
author:          adust09
maintainer:      adust09
category:        Network
build-type:      Simple
extra-doc-files: README.md
tested-with:     GHC == 9.10.1

common warnings
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
               -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints

common lang
  default-language:   GHC2021
  default-extensions:
    OverloadedStrings
    StrictData

library
  import:          warnings, lang
  hs-source-dirs:  src
  other-modules: PackageInfo_hs_libp2p
  autogen-modules: PackageInfo_hs_libp2p
  exposed-modules:
    LibP2P
    LibP2P.Core.Binary
    LibP2P.Core.Varint
    LibP2P.Core.Multihash
    LibP2P.Multiaddr
    LibP2P.Multiaddr.Protocol
    LibP2P.Multiaddr.Codec
    LibP2P.Crypto.Key
    LibP2P.Crypto.Ed25519
    LibP2P.Crypto.RSA
    LibP2P.Crypto.Secp256k1
    LibP2P.Crypto.ECDSA
    LibP2P.Crypto.Protobuf
    LibP2P.Crypto.PeerId
    LibP2P.MultistreamSelect.Wire
    LibP2P.MultistreamSelect.Negotiation
    LibP2P.Yamux.Frame
    LibP2P.Yamux.Types
    LibP2P.Yamux.Stream
    LibP2P.Yamux.Session
    LibP2P.Transport
    LibP2P.Transport.TCP
    LibP2P.Transport.QUIC
    LibP2P.Transport.QUIC.Certificate
    LibP2P.Switch.Types
    LibP2P.Switch.ConnPool
    LibP2P.Switch.Connection
    LibP2P.Switch
    LibP2P.Switch.Dial
    LibP2P.Switch.Listen
    LibP2P.Switch.Upgrade
    LibP2P.Switch.ResourceManager
    LibP2P.Switch.CertifiedRecords
    LibP2P.Protocol.Identify.Message
    LibP2P.Protocol.Identify
    LibP2P.Protocol.Ping
    LibP2P.Protocol.Perf
    LibP2P.DHT.Types
    LibP2P.DHT.Distance
    LibP2P.DHT.RoutingTable
    LibP2P.DHT.Message
    LibP2P.DHT.Validator
    LibP2P.DHT
    LibP2P.DHT.Lookup
    LibP2P.DHT.API
    LibP2P.NAT.AutoNAT.Message
    LibP2P.NAT.AutoNAT
    LibP2P.Crypto.SignedEnvelope
    LibP2P.Crypto.PeerRecord
    LibP2P.NAT.Relay.Message
    LibP2P.NAT.Relay
    LibP2P.NAT.Relay.Client
    LibP2P.NAT.Relay.Transport
    LibP2P.NAT.DCUtR.Message
    LibP2P.NAT.DCUtR
    LibP2P.NAT
    LibP2P.Noise.Framing
    LibP2P.Noise.Handshake
    LibP2P.Noise.Session
    LibP2P.Protocol.GossipSub.Types
    LibP2P.Protocol.GossipSub.Message
    LibP2P.Protocol.GossipSub.Router
    LibP2P.Protocol.GossipSub.Score
    LibP2P.Protocol.GossipSub.Validation
    LibP2P.Protocol.GossipSub.MessageCache
    LibP2P.Protocol.GossipSub.Heartbeat
    LibP2P.Protocol.GossipSub.Handler
  build-depends:
    base        >= 4.18 && < 5,
    bytestring  >= 0.10 && < 0.13,
    binary      >= 0.8.9 && < 0.9,
    text        >= 1.2  && < 2.2,
    cacophony   >= 0.11 && < 0.12,
    crypton     >= 1.0.5 && < 1.1,
    crypton-x509 >= 1.8  && < 1.9,
    crypton-x509-validation >= 1.8 && < 1.9,
    crypton-asn1-types >= 0.4 && < 0.5,
    crypton-asn1-encoding >= 0.9 && < 0.11,
    memory      >= 0.18  && < 0.19,
    ppad-base58 >= 0.2  && < 0.3,
    iproute     >= 1.7  && < 1.8,
    network     >= 3.2.3 && < 3.3,
    quic        >= 0.2.23 && < 0.3,
    tls         >= 2.2   && < 2.3,
    time-hourglass >= 0.3 && < 0.4,
    time        >= 1.9  && < 2,
    stm         >= 2.4  && < 2.6,
    async       >= 2.2  && < 2.3,
    containers  >= 0.6  && < 0.8,
    proto3-wire >= 1.4  && < 1.5,
    list-shuffle >= 1.0  && < 1.1

executable libp2p-interop
  import:          warnings, lang
  hs-source-dirs:  interop/transport
  main-is:         Main.hs
  build-depends:
    base        >= 4.18 && < 5,
    bytestring  >= 0.10 && < 0.13,
    text        >= 1.2  && < 2.2,
    time        >= 1.9  && < 2,
    network     >= 3.1  && < 3.3,
    hedis       >= 0.15 && < 0.16,
    aeson       >= 2.1  && < 2.3,
    stm         >= 2.4  && < 2.6,
    hs-libp2p
  ghc-options: -threaded -rtsopts

executable libp2p-perf
  import:          warnings, lang
  hs-source-dirs:  interop/perf
  main-is:         Main.hs
  other-modules:
    PerfInterop.Stats
  build-depends:
    base        >= 4.18 && < 5,
    bytestring  >= 0.10 && < 0.13,
    text        >= 1.2  && < 2.2,
    time        >= 1.9  && < 2,
    network     >= 3.1  && < 3.3,
    hedis       >= 0.15 && < 0.16,
    hs-libp2p
  ghc-options: -threaded -rtsopts

executable libp2p-hole-punch
  import:          warnings, lang
  hs-source-dirs:  interop/hole-punch
  main-is:         Main.hs
  build-depends:
    base        >= 4.18 && < 5,
    bytestring  >= 0.10 && < 0.13,
    text        >= 1.2  && < 2.2,
    time        >= 1.9  && < 2,
    network     >= 3.1  && < 3.3,
    hedis       >= 0.15 && < 0.16,
    stm         >= 2.4  && < 2.6,
    hs-libp2p
  ghc-options: -threaded -rtsopts

executable libp2p-kad-dht-node
  import:          warnings, lang
  hs-source-dirs:  interop/kad-dht-node
  main-is:         Main.hs
  build-depends:
    base        >= 4.18 && < 5,
    bytestring  >= 0.10 && < 0.13,
    text        >= 1.2  && < 2.2,
    time        >= 1.9  && < 2,
    network     >= 3.1  && < 3.3,
    hedis       >= 0.15 && < 0.16,
    stm         >= 2.4  && < 2.6,
    containers  >= 0.6  && < 0.8,
    hs-libp2p
  ghc-options: -threaded -rtsopts

test-suite hs-libp2p-test
  import:          warnings, lang
  type:            exitcode-stdio-1.0
  hs-source-dirs:  test, interop/perf
  main-is:         Spec.hs
  other-modules:
    PerfInterop.Stats
    PerfInterop.StatsSpec
    LibP2P.Core.VarintSpec
