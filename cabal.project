packages: .

source-repository-package
  type: git
  location: https://github.com/adust09/quic.git
  tag: 912fd264a812c57f8c75528b74e60c96f89c7734

-- Always enable test suites in solver plans (fixes cabal 3.12 Cabal-7043 error)
tests: True

-- Requires GHC 9.10.x (base < 4.22) for cacophony compatibility.
-- CI: haskell-actions/setup installs ghc-9.10.1 and puts 'ghc' on PATH.
-- Local: set 'with-compiler' in cabal.project.local if needed.

-- Enable all warnings
package hs-libp2p
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
